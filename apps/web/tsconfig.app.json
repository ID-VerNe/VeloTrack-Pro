{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* 修复：显式开启严格模式（原先遗漏 strict，整个 web 包以非严格模式编译，隐式 any 等错误全部被放行） */
    "strict": true,
    "noUncheckedIndexedAccess": false,

    /* 共享包路径映射:Vite alias 与 TS paths 双向对齐,确保 tsc --noEmit 也能解析 */
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@velotrack/core": ["../../packages/core/src/index.ts"],
      "@velotrack/core/geo": ["../../packages/core/src/geo.ts"],
      "@velotrack/core/hr": ["../../packages/core/src/hr.ts"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}

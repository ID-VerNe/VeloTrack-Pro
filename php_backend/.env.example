# Cycling 后端管理令牌（Bearer 鉴权）。
# 客户端在 Authorization: Bearer <token> 头里携带，PHP 用 hash_equals 校验。
# 32 字节随机串，如 openssl rand -hex 16 的输出。
# 未配置时为开放模式（仅限本地开发，生产必须配置）。
# 部署后保持只读（chmod 600），勿提交到 git（.gitignore 已含 .env）。
ADMIN_TOKEN=

# AI Gateway 配置（前端直调，这里只做 base_url/model_name 的默认值回显与跨设备同步）
AI_GATEWAY_BASE=https://api-gateway.yuuverne.site
AI_GATEWAY_MODEL=velotrack-coach
